# ============================================================
# CONFIGURACION DE GROQ (recomendado - gratis)
# ============================================================
#
# PASO 1 - Crear cuenta
#   Ve a: https://console.groq.com/
#   Registrate con Google o email (gratis, sin tarjeta)
#
# PASO 2 - Crear API Key
#   En el menu: API Keys -> Create API Key
#   Copia la clave (empieza con gsk_...)
#
# PASO 3 - Pegar aqui
#   Copia este archivo como .env en esta misma carpeta (demo/)
#   y pega tu clave abajo:
#
GROQ_API_KEY=gsk_tu_clave_aqui

# Modelo recomendado (rapido y gratis):
GROQ_MODEL=llama-3.1-8b-instant

# Alternativa mas inteligente pero mas lenta:
# GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================
# Sin GROQ_API_KEY el grupo usa plantillas locales (funciona igual,
# pero las respuestas son menos naturales).
# ============================================================
